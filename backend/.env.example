# Copy to `.env` and fill in. Never commit `.env`.

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://devpulse:devpulse@localhost:5432/devpulse
REDIS_URL=redis://localhost:6379/0

# Long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Must be a Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Integrations
GITHUB_TOKEN=
# Optional: several tokens, comma-separated, to spread rate limits
GITHUB_TOKENS=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_WEBHOOK_URL=

# Used by seed_users.py / test_components.py
GITHUB_TEST_REPO=
JIRA_TEST_TICKET=DEV-1
MIN_WORKERS=4
